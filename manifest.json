{
  "manifest_version": 3,
  "name": "Cross-Store Owned",
  "version": "0.4.0",
  "description": "Badges games on Steam that you already own on GOG, and games on GOG that you already own on Steam",
  "browser_specific_settings": {
    "gecko": {
      "id": "cross-store-owned@inklikeurine.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage", "alarms", "unlimitedStorage"],
  "host_permissions": [
    "https://store.steampowered.com/*",
    "https://api.steampowered.com/*",
    "https://www.gog.com/*",
    "https://embed.gog.com/*",
    "https://api.gog.com/*",
    "https://api.isthereanydeal.com/*"
  ],
  "background": {
    "scripts": ["lib/common.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://store.steampowered.com/*"],
      "js": ["lib/common.js", "content/badges.js", "content/steam.js"],
      "css": ["content/badges.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.gog.com/*"],
      "js": ["lib/common.js", "content/badges.js", "content/gog.js"],
      "css": ["content/badges.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Cross-Store Owned",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
