{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node ../firefox-tools/tools/*)",
      "Bash(node ../firefox-tools/harness/*)",
      "Bash(web-ext lint *)",
      "Bash(web-ext build *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "additionalDirectories": ["../firefox-tools", "../_workshop"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/../firefox-tools/tools/on-edit.mjs\" ]; then node \"$CLAUDE_PROJECT_DIR/../firefox-tools/tools/on-edit.mjs\"; fi",
            "timeout": 60,
            "statusMessage": "Validating extension…"
          }
        ]
      }
    ]
  }
}
